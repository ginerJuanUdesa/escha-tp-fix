+def _tp_shard_2d(t: torch.Tensor, dim: int, rank: int, size: int) -> torch.Tensor:
+    """Slice a 2D or 1D tensor along `dim` into `size` equal chunks and return the
+    rank-th chunk. Used to shard int8-as-stored weights that Escha's install path
+    otherwise duplicates on every TP rank."""
+    if size == 1:
+        return t
+    total = t.shape[dim]
+    assert total % size == 0, f"tensor dim {dim} size {total} not divisible by tp {size}"
+    per = total // size
+    return t.narrow(dim, rank * per, per).contiguous()
+
